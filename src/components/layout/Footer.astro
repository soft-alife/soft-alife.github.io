---
interface Props {
  lang?: "ko" | "en";
}

const { lang = "ko" } = Astro.props;

import koTranslations from "../../i18n/ko.json";
import enTranslations from "../../i18n/en.json";

const t = lang === "en" ? enTranslations : koTranslations;
const currentYear = new Date().getFullYear();
---

<footer class="bg-secondary">
  <div
    class="flex flex-col md:flex-row items-start justify-between w-full max-w-[1200px] mx-auto px-6 lg:px-[60px] py-10 gap-8"
  >
    <!-- Left side -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <img
          src="/images/logos/sal-logo.png"
          alt="SAL Logo"
          width="28"
          height="28"
          class="w-7 h-7 object-contain opacity-70"
        />
        <span class="text-sm text-muted font-semibold">
          SAL &mdash; Soft Artificial Life Laboratory
        </span>
      </div>
      <div class="flex flex-col gap-1 pl-9">
        <p class="text-sm text-muted">
          {
            lang === "ko"
              ? "제주대학교 컴퓨터공학과"
              : "Dept. of Computer Engineering, Jeju National University"
          }
        </p>
        <p class="text-sm text-muted">{t.footer.address}</p>
        <p class="text-sm text-muted-foreground mt-2">
          &copy; {currentYear} SAL Laboratory. All rights reserved.
        </p>
      </div>
    </div>

    <!-- Right side -->
    <div class="flex flex-col items-start md:items-end gap-2">
      <p class="text-sm text-muted font-medium">
        {
          lang === "ko" ? "제주대학교" : "Jeju National University"
        }
      </p>
      <a
        href="mailto:spark@jejunu.ac.kr"
        class="text-sm text-muted hover:text-foreground transition-colors underline underline-offset-2"
      >
        spark@jejunu.ac.kr
      </a>
    </div>
  </div>
</footer>
