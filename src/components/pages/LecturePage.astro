---
/**
 * Lecture page (shared between /lecture and /en/lecture).
 *
 * lectures.yaml의 강의를 연도·학기별로 그룹핑해 최신순으로 표시한다.
 * 학기 안에서 학부/대학원 소제목으로 나누고, 각 강의는 글머리표 한 줄로 표시.
 * 한국어 페이지: "한국어 과목명 [English Title]", 영어 페이지: "English Title".
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { loadLectures } from "@/lib/content";

interface Props {
  lang: "ko" | "en";
}

const { lang } = Astro.props;

const dict = {
  ko: {
    pageTitle: "Lecture - SAL Laboratory",
    metaDescription: "박승민 교수 학기별 강의 목록",
    headerTitle: "Lecture",
    breadcrumb: "SAL > Lecture",
    empty: "등록된 강의가 없습니다.",
    undergrad: "학부",
    grad: "대학원",
  },
  en: {
    pageTitle: "Lecture - SAL Laboratory",
    metaDescription: "Courses taught by Prof. Seungmin Park",
    headerTitle: "Lecture",
    breadcrumb: "SAL > Lecture",
    empty: "No lectures registered.",
    undergrad: "Undergraduate",
    grad: "Graduate",
  },
} as const;

// 영어 페이지 학기 표기 ("2026, Fall"). 목록에 없는 값은 그대로 표시.
const semesterEn: Record<string, string> = {
  "1학기": "Spring",
  "여름학기": "Summer",
  "2학기": "Fall",
  "겨울학기": "Winter",
};

const T = dict[lang];

const lectures = loadLectures();

// 연도·학기별 그룹 (최신 연도 먼저, 같은 연도는 학기 문자열 역순: 2학기 → 1학기)
const groupKey = (l: (typeof lectures)[number]) => `${l.year}|${l.semester}`;
const groups = [...new Set(lectures.map(groupKey))]
  .sort((a, b) => b.localeCompare(a))
  .map((key) => {
    const [year, semester] = key.split("|");
    return {
      title:
        lang === "ko"
          ? `${year}년 ${semester}`
          : `${year}, ${semesterEn[semester] ?? semester}`,
      // 학부 → 대학원 순 소그룹 (강의가 없는 소그룹은 생략)
      levels: (["학부", "대학원"] as const)
        .map((level) => ({
          label: level === "학부" ? T.undergrad : T.grad,
          items: lectures.filter(
            (l) => groupKey(l) === key && l.level === level,
          ),
        }))
        .filter((sub) => sub.items.length > 0),
    };
  });

const lectureName = (l: (typeof lectures)[number]) =>
  lang === "en"
    ? l.titleEn || l.title
    : l.titleEn
      ? `${l.title} [${l.titleEn}]`
      : l.title;
---

<BaseLayout
  title={T.pageTitle}
  description={T.metaDescription}
  activeNav="Lecture"
  lang={lang}
>
  <PageHeader title={T.headerTitle} breadcrumb={T.breadcrumb} />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    {groups.length === 0 && (
      <p class="text-[13px] text-[#A1A1AA] py-8 text-center">{T.empty}</p>
    )}

    {groups.map((group, i) => (
      <section class={i === 0 ? "" : "mt-[48px]"}>
        <h2 class="text-2xl font-bold text-foreground mb-2">{group.title}</h2>
        {group.levels.map((sub) => (
          <div class="mt-4">
            <h3 class="text-base font-semibold text-muted-foreground mb-2">{sub.label}</h3>
            <ul class="list-disc pl-6 space-y-2 text-base text-foreground marker:text-muted-foreground">
              {sub.items.map((lecture) => (
                <li class="leading-relaxed">
                  {lectureName(lecture)}
                  {lecture.description && (
                    <span class="text-muted-foreground"> — {lecture.description}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </div>
</BaseLayout>
