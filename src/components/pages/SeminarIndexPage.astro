---
/**
 * Seminar list page (shared between /seminar and /en/seminar).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SeminarFilter from "@/components/sections/SeminarFilter";
import { getCollection } from "astro:content";

interface Props {
  lang: "ko" | "en";
}

const { lang } = Astro.props;

const dict = {
  ko: {
    pageTitle: "Seminar — SAL Lab",
    metaDescription: "SAL 연구실 세미나 목록",
    headerTitle: "Seminar",
    breadcrumb: "SAL > 세미나",
    intro: "논문 발표, 최신 기술에 대한 심층 토론을 합니다.",
  },
  en: {
    pageTitle: "Seminar — SAL Lab",
    metaDescription: "SAL Laboratory Seminar List",
    headerTitle: "Seminar",
    breadcrumb: "SAL > Seminar",
    intro: "Paper presentations and in-depth discussions on the latest technologies.",
  },
} as const;

const T = dict[lang];

const allSeminars = await getCollection("seminars");
const sorted = allSeminars.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const seminarsData = sorted.map((s) => ({
  slug: s.id.replace(/\.md$/, ""),
  title: s.data.title,
  date: s.data.date.toISOString(),
  presenter: s.data.presenter,
  affiliation: s.data.affiliation ?? "",
  category: s.data.category,
  tags: s.data.tags ?? [],
  summary: s.data.summary ?? "",
}));
---

<BaseLayout
  title={T.pageTitle}
  description={T.metaDescription}
  activeNav="Seminar"
  lang={lang}
>
  <PageHeader title={T.headerTitle} breadcrumb={T.breadcrumb} />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <p class="text-[14px] text-muted mb-8">{T.intro}</p>

    <SeminarFilter client:load seminars={seminarsData} itemsPerPage={5} />
  </div>
</BaseLayout>
