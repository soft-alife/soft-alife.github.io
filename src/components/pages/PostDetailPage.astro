---
/**
 * News/Blog 직접 작성 글 상세 페이지 (shared between ko/en, news/blog).
 *
 * Publications 페이지의 News/Blog 탭에서 link가 없는(직접 작성) 글을
 * 클릭하면 이 페이지로 들어온다. Layout mirrors NoticeDetailPage.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  lang: "ko" | "en";
  entry: CollectionEntry<"news"> | CollectionEntry<"blog">;
  type: "news" | "blog";
}

const { lang, entry, type } = Astro.props;
const prefix = lang === "en" ? "/en" : "";

const dict = {
  ko: {
    breadcrumb: type === "news" ? "SAL > News" : "SAL > Blog",
    back: "목록으로 돌아가기",
  },
  en: {
    breadcrumb: type === "news" ? "SAL > News" : "SAL > Blog",
    back: "Back to List",
  },
} as const;

const T = dict[lang];
const { Content } = await render(entry);

// news는 source, blog는 author를 배지로 표시
const badge =
  "source" in entry.data ? entry.data.source : (entry.data as { author?: string }).author ?? "";

const formatDate = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}.${m}.${d}`;
};
---

<BaseLayout
  title={`${entry.data.title} — SAL Lab`}
  description={entry.data.summary || entry.data.title}
  activeNav="Publications"
  lang={lang}
>
  <!-- Page Header -->
  <div class="bg-[#FAFAFA] border-b border-border px-6 lg:px-[60px] pt-7 pb-5">
    <div class="max-w-[1200px] mx-auto">
      <p class="text-sm text-muted-foreground mb-2">
        <a href={`${prefix}/${type}`} class="hover:text-foreground transition-colors">{T.breadcrumb}</a>
      </p>
      <div class="flex items-center gap-3">
        <h1 class="text-[24px] font-bold text-foreground">{entry.data.title}</h1>
        {badge && (
          <span class="inline-block px-2.5 py-[3px] text-[11px] rounded-full bg-[#F5F5F5] text-[#52525B]">
            {badge}
          </span>
        )}
      </div>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <div class="max-w-[800px]">
      <!-- Meta -->
      <div class="mb-6 pb-6 border-b border-border">
        <div class="flex items-center gap-3 text-[13px] text-muted">
          <span>{formatDate(entry.data.date)}</span>
        </div>
      </div>

      <!-- Markdown Body (typography 플러그인이 없어 요소별로 직접 스타일 지정) -->
      <article class="max-w-none
        [&_h2]:text-[22px] [&_h2]:font-bold [&_h2]:text-foreground [&_h2]:mt-10 [&_h2]:mb-4
        [&_h3]:text-[17px] [&_h3]:font-semibold [&_h3]:text-foreground [&_h3]:mt-6 [&_h3]:mb-3
        [&_p]:text-[14px] [&_p]:text-[#3F3F46] [&_p]:leading-relaxed [&_p]:mb-4
        [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4
        [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:mb-4
        [&_li]:text-[14px] [&_li]:text-[#3F3F46] [&_li]:leading-relaxed [&_li]:mb-1.5
        [&_strong]:font-semibold [&_strong]:text-foreground
        [&_a]:text-sal-terracotta [&_a:hover]:underline
        [&_img]:rounded-lg [&_img]:my-6
        [&_blockquote]:border-l-4 [&_blockquote]:border-border [&_blockquote]:pl-4 [&_blockquote]:text-muted
        [&_table]:text-[13px] [&_th]:bg-[#F5F5F5] [&_th]:px-3 [&_th]:py-2
        [&_td]:px-3 [&_td]:py-2 [&_td]:border [&_td]:border-border
      ">
        <Content />
      </article>

      <!-- Back Link -->
      <div class="mt-10 pt-6 border-t border-border">
        <a
          href={`${prefix}/${type}`}
          class="inline-flex items-center gap-1 text-[13px] text-muted hover:text-foreground transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          {T.back}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
