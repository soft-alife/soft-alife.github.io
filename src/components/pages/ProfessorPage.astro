---
/**
 * Professor page (shared between /professor and /en/professor).
 *
 * The bio/education/career text is bilingual via `dict`. Education and
 * career are arrays of strings — to add or change a line, edit the array.
 *
 * Publications (journals/conferences), patents, tech transfers, and awards
 * are loaded from professor.yaml; projects from projects.yaml. Journal and
 * conference lists are grouped (SCI/SCIE · SCOPUS · KCI, 탑티어 · 국제 · 국내)
 * and rendered as collapsible sections via PublicationGroup.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import Accordion from "@/components/ui/Accordion.tsx";
import PublicationGroup from "@/components/ui/PublicationGroup.tsx";
import { loadProfessor, loadProjects } from "@/lib/content";

interface Props {
  lang: "ko" | "en";
}

const { lang } = Astro.props;

const dict = {
  ko: {
    pageTitle: "지도교수 | SAL Lab",
    metaDescription: "SAL 연구실 지도교수 박승민 교수 소개",
