} as const;

const T = dict[lang];

// ---------------------------------------------------------------------------
// Professor achievements (professor.yaml) → collapsible publication groups
// ---------------------------------------------------------------------------
const professor = loadProfessor();

// 배지 색상 규칙:
//   노랑 — SCI/SCIE, 탑티어 컨퍼런스, 국제 특허
//   파랑 — 국제학술대회, 국내 특허 등록
//   연푸른색 — SCOPUS
//   회색 — KCI, 국내학술대회, 국내 특허 출원
const badgeColors = {
  yellow: "bg-[#FEF3C7] text-[#92400E]",
  blue: "bg-[#DBEAFE] text-[#1E40AF]",
  lightBlue: "bg-[#EFF6FF] text-[#1D4ED8]",
  gray: "bg-[#F5F5F5] text-[#52525B]",
} as const;

const indexBadgeColors = {
  sci: badgeColors.yellow,
  scopus: badgeColors.lightBlue,
  kci: badgeColors.gray,
} as const;

const tierBadgeColors = {
  top: badgeColors.yellow,
  international: badgeColors.blue,
  domestic: badgeColors.gray,
} as const;

// 저자 구분: 제1저자 노랑 / 교신저자 파랑 / 공동저자 회색
const roleBadgeColors = {
  first: badgeColors.yellow,
  corresponding: badgeColors.blue,
  co: badgeColors.gray,
} as const;

const badgeStyles = {
  note: "bg-[#FEF3C7] text-[#92400E]", // awards/notes
  date: "bg-secondary text-secondary-foreground", // 날짜/기간 배지
} as const;

const indexLabels = { sci: "SCI/SCIE", scopus: "SCOPUS", kci: "KCI" } as const;
const tierLabels = {
  top: T.tierTop,
  international: T.tierIntl,
  domestic: T.tierDomestic,
} as const;
const roleLabels = {
  first: T.roleFirst,
  corresponding: T.roleCorresponding,
  co: T.roleCo,
} as const;

const byDateDesc = (a: { date: string }, b: { date: string }) =>
  b.date.localeCompare(a.date);

function journalItems(index: "sci" | "scopus" | "kci") {
  return professor.journals
    .filter((j) => j.index === index)
    .sort(byDateDesc)
    .map((j) => ({
      badges: [
        { label: j.date, className: badgeStyles.date },
        { label: indexLabels[j.index], className: indexBadgeColors[j.index] },
        ...(j.authorRole
          ? [{ label: roleLabels[j.authorRole], className: roleBadgeColors[j.authorRole] }]
          : []),
        ...(j.note ? [{ label: j.note, className: badgeStyles.note }] : []),
      ],
      title: j.title,
      meta: j.venue + (j.volume ? `, ${j.volume}` : ""),
      sub: "",
      subStrong: [j.impactFactor ? `IF ${j.impactFactor}` : "", j.quartile]
        .filter(Boolean)
        .join(" · "),
      link: j.url || (j.doi ? `https://doi.org/${j.doi}` : ""),
    }));
}

function conferenceItems(tier: "top" | "international" | "domestic") {
  return professor.conferences
    .filter((c) => c.tier === tier)
    .sort(byDateDesc)
    .map((c) => ({
      badges: [
        { label: c.date, className: badgeStyles.date },
        { label: tierLabels[c.tier], className: tierBadgeColors[c.tier] },
        ...(c.authorRole
          ? [{ label: roleLabels[c.authorRole], className: roleBadgeColors[c.authorRole] }]
          : []),
        ...(c.note ? [{ label: c.note, className: badgeStyles.note }] : []),
      ],
      title: c.title,
      meta: c.venue + (c.volume ? `, ${c.volume}` : ""),
      sub: "",
      link: c.url || (c.doi ? `https://doi.org/${c.doi}` : ""),
    }));
}

const sciItems = journalItems("sci");
const scopusItems = journalItems("scopus");
const kciItems = journalItems("kci");
const topItems = conferenceItems("top");
const intlItems = conferenceItems("international");
const domesticItems = conferenceItems("domestic");

// Patents: 등록 → 출원 순. 등록건은 등록일, 출원건은 출원일 기준 최신순.
const patents = [...professor.patents].sort((a, b) => {
  if (a.status !== b.status) return a.status === "registered" ? -1 : 1;
  const da =
    a.status === "registered" ? a.registrationDate || a.applicationDate : a.applicationDate;
  const db =
    b.status === "registered" ? b.registrationDate || b.applicationDate : b.applicationDate;
  return db.localeCompare(da);
});

function patentStatusLabel(p: (typeof patents)[number]) {
  const base = p.status === "registered" ? T.statusRegistered : T.statusFiled;
  return p.kind === "design" ? `${T.designPrefix} ${base}` : base;
}

function patentNumberLine(p: (typeof patents)[number]) {
  const parts: string[] = [];
  if (p.applicationNumber) {
    parts.push(
      `${T.appLabel} ${p.applicationNumber}` +
        (p.applicationDate ? ` (${p.applicationDate})` : ""),
    );
  }
  if (p.registrationNumber) {
    parts.push(
      `${T.regLabel} ${p.registrationNumber}` +
        (p.registrationDate ? ` (${p.registrationDate})` : ""),
    );
  }
  return parts.join(" · ");
}

// 특허는 KIPRIS 상세 페이지로 연결 — 특허 DOI(10.8080/출원번호)가 KIPRIS로
// 리다이렉트된다 (등록·출원 25건 전부 DOI 실존 검증됨. 디자인은 미발급이라 제외).
function patentLink(p: (typeof patents)[number]) {
  if (p.url) return p.url;
  if (p.kind === "patent" && p.applicationNumber) {
    return `https://doi.org/10.8080/${p.applicationNumber.replace(/-/g, "")}`;
  }
  return "";
}

// Patents rendered as one collapsible group.
// 색상: 국제 특허 노랑 / 국내 등록 파랑 / 국내 출원 회색.
const patentItems = patents.map((p) => ({
  badges: [
    {
      label: p.registrationDate || p.applicationDate,
      className: badgeStyles.date,
    },
    {
      label: patentStatusLabel(p),
      className:
        p.country === "international"
          ? badgeColors.yellow
          : p.status === "registered"
            ? badgeColors.blue
            : badgeColors.gray,
    },
    ...(p.note ? [{ label: p.note, className: badgeColors.lightBlue }] : []),
  ],
  title: p.title,
  meta: patentNumberLine(p),
  sub: "",
  link: patentLink(p),
}));

// Tech transfers rendered as one collapsible group (금액은 표시하지 않음).
// 근거 특허(patentNumber)와 같은 특허 페이지로 연결한다.
const techTransferItems = professor.techTransfers.map((tt) => {
  const basePatent = patents.find(
    (p) => p.registrationNumber === tt.patentNumber,
  );
  return {
    badges: [
      { label: String(tt.year), className: badgeStyles.date },
      { label: T.techBadge, className: badgeColors.lightBlue },
    ],
    title: tt.title,
    meta:
      lang === "ko"
        ? `특허 제${tt.patentNumber}호`
        : `Patent No. ${tt.patentNumber}`,
    sub: "",
    link: basePatent ? patentLink(basePatent) : "",
  };
});

// Awards rendered as one collapsible group (날짜 배지 + 수상명 배지 + 대회/기관명).
const awardItems = [...professor.awards].sort(byDateDesc).map((a) => ({
  badges: [
    { label: a.date, className: badgeStyles.date },
    { label: a.award, className: badgeStyles.note },
  ],
  title: a.event,
  meta: a.note,
  sub: "",
}));

// All projects from projects.yaml (yaml order = newest first) as one
// collapsible group. Meta line: 지원기관/주무부처 labels per language.
// 국가연구과제는 노란 배지 + NTIS 검색 링크로 연결한다.
const ntisSearch = (title: string) =>
  `https://www.ntis.go.kr/ThSearchTotalList.do?searchWord=${encodeURIComponent(title)}`;

const projectItems = loadProjects().map((p) => ({
  badges: [
    { label: p.period, className: badgeStyles.date },
    ...(p.national
      ? [{ label: T.nationalLabel, className: badgeColors.yellow }]
      : []),
    // 연구책임자는 노란색 배지
    ...(p.role ? [{ label: p.role, className: badgeColors.yellow }] : []),
  ],
  title: lang === "en" ? (p.titleEn || p.title) : p.title,
  meta: [
    `${T.fundingLabel} : ${p.funding}`,
    ...(p.ministry ? [`${T.ministryLabel} : ${p.ministry}`] : []),
  ].join(", "),
  sub: p.description,
  link: p.url || (p.national ? ntisSearch(p.title) : ""),
}));
---

<BaseLayout
  title={T.pageTitle}
  description={T.metaDescription}
  activeNav="Professor"
  lang={lang}
>
  <PageHeader title={T.headerTitle} breadcrumb={T.breadcrumb} />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <!-- Profile Section -->
    <section class="flex flex-col lg:flex-row gap-10 mb-[48px]">
      <!-- Left: Photo -->
      <div class="shrink-0">
        <img
          src="/images/professor/park-seungmin.jpg"
          alt={T.photoAlt}
          width="280"
          height="350"
          class="w-[280px] rounded-lg object-cover bg-secondary"
        />
      </div>

      <!-- Right: Info -->
      <div class="flex-1 min-w-0">
        <!-- Name & Badge -->
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[24px] font-bold text-foreground">{T.name}</h2>
          <span
            class="inline-flex items-center px-2 py-0.5 rounded-pill bg-[#DBEAFE] text-[#1E40AF] text-sm font-medium"
          >
            {T.rankBadge}
          </span>
        </div>

        <!-- Title & Affiliation -->
        <p class="text-lg text-foreground font-medium mb-1">{T.titleLine}</p>
        <p class="text-base text-muted mb-6">{T.affiliation}</p>

        <!-- Bio -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.bioHeading}</h3>
          <div class="space-y-3 text-base text-muted leading-relaxed">
            {T.bioParagraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <!-- Education -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.educationHeading}</h3>
          <ul class="space-y-1.5 text-base text-muted">
            {T.education.map((line) => (
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.contactHeading}</h3>
          <ul class="space-y-1.5 text-base text-muted">
            <li>
              <span class="text-foreground font-medium">{T.emailLabel}</span>{" "}
              <a
                href="mailto:spark@jejunu.ac.kr"
                class="hover:text-foreground transition-colors underline underline-offset-2"
              >
                spark@jejunu.ac.kr
              </a>
            </li>
            <li>
              <span class="text-foreground font-medium">{T.specLabel}</span> {T.spec}
            </li>
          </ul>
        </div>

        <!-- Career -->
        <div>
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.careerHeading}</h3>
          <ul class="space-y-1.5 text-base text-muted">
            {T.career.map((line) => (
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Research Interests — Accordion -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.interestsHeading}</h2>
      <Accordion items={[...T.researchItems]} client:load />
    </section>

    <!-- Publications -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.pubsHeading}</h2>

      <!-- Journals: SCI/SCIE · SCOPUS · KCI -->
      <div class="mb-8">
        <h3 class="text-lg font-semibold text-foreground mb-2">{T.journalsHeading}</h3>
        <PublicationGroup
          title="SCI/SCIE"
          items={sciItems}
          defaultOpen={true}
          showAllLabel={T.showAll}
          collapseLabel={T.collapse}
          client:load
        />
        <PublicationGroup
          title="SCOPUS"
          items={scopusItems}
          defaultOpen={true}
          showAllLabel={T.showAll}
          collapseLabel={T.collapse}
          client:load
        />
        <PublicationGroup
          title="KCI"
          items={kciItems}
          defaultOpen={false}
          showAllLabel={T.showAll}
          collapseLabel={T.collapse}
          client:load
        />
      </div>

      <!-- Conferences: 탑티어 · 국제 · 국내 -->
      <div>
        <h3 class="text-lg font-semibold text-foreground mb-2">{T.conferencesHeading}</h3>
        {topItems.length > 0 && (
          <PublicationGroup
            title={T.groupTop}
            items={topItems}
            defaultOpen={true}
            showAllLabel={T.showAll}
            collapseLabel={T.collapse}
            client:load
          />
        )}
        <PublicationGroup
          title={T.groupIntl}
          items={intlItems}
          defaultOpen={true}
          showAllLabel={T.showAll}
          collapseLabel={T.collapse}
          client:load
        />
        <PublicationGroup
          title={T.groupDomestic}
          items={domesticItems}
          defaultOpen={false}
          showAllLabel={T.showAll}
          collapseLabel={T.collapse}
          client:load
        />
      </div>
    </section>

    <!-- Research Projects -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.projectsHeading}</h2>
      <PublicationGroup
        title={T.groupAll}
        items={projectItems}
        defaultOpen={true}
        showAllLabel={T.showAll}
        collapseLabel={T.collapse}
        client:load
      />
    </section>

    <!-- Patents -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.patentsHeading}</h2>
      <PublicationGroup
        title={T.groupAll}
        items={patentItems}
        defaultOpen={true}
        showAllLabel={T.showAll}
        collapseLabel={T.collapse}
        client:load
      />
    </section>

    <!-- Technology Transfer -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.techHeading}</h2>
      <PublicationGroup
        title={T.groupAll}
        items={techTransferItems}
        defaultOpen={true}
        showAllLabel={T.showAll}
        collapseLabel={T.collapse}
        client:load
      />
    </section>

    <!-- Awards -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.awardsHeading}</h2>
      <PublicationGroup
        title={T.groupAll}
        items={awardItems}
        defaultOpen={true}
        showAllLabel={T.showAll}
        collapseLabel={T.collapse}
        client:load
      />
    </section>
  </div>
</BaseLayout>
