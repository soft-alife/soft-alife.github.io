---
/**
 * Professor page (shared between /professor and /en/professor).
 *
 * The bio/education/career text is bilingual via `dict`. Education and
 * career are arrays of strings — to add or change a line, edit the array.
 *
 * Publications and projects are loaded from publications.yaml/projects.yaml
 * via the centralized loaders. Patents stay hardcoded as placeholder data.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import Accordion from "@/components/ui/Accordion.tsx";
import { loadPublications, loadProjects } from "@/lib/content";

interface Props {
  lang: "ko" | "en";
}

const { lang } = Astro.props;

const dict = {
  ko: {
    pageTitle: "지도교수 | SAL Lab",
    metaDescription: "SAL 연구실 지도교수 박승민 교수 소개",
    headerTitle: "Professor",
    breadcrumb: "SAL > 지도교수",
    photoAlt: "박승민 교수 프로필 사진",
    name: "박승민",
    rankBadge: "부교수",
    titleLine: "박승민 부교수 · Ph.D.",
    affiliation: "제주대학교 공과대학 컴퓨터공학과",
    bioHeading: "소개",
    bioParagraphs: [
      "박승민 교수는 제주대학교 컴퓨터공학과에서 지능시스템, 인공생명, 기계학습, 최적화 이론 분야를 연구하고 있습니다. 진화연산, 물리정보신경망(PINN), 뇌-컴퓨터 인터페이스(BCI) 등을 세부 전공으로 하고 있습니다.",
      "SAL(Soft Artificial Life) 연구실을 이끌며, 대학원생 및 학부 연구생들과 함께 인공생명 시뮬레이션, 지능시스템, 기계학습 응용, 최적화 등 다양한 연구 프로젝트를 수행하고 있습니다.",
    ],
    educationHeading: "학력",
    education: [
      "공학박사 — 중앙대학교 제어및시스템공학, 지능시스템 (2019.02)",
      "공학사 — 중앙대학교 전자전기공학부 (2010.02)",
    ],
    contactHeading: "연락처",
    emailLabel: "이메일:",
    specLabel: "세부전공:",
    spec: "지능시스템 / 최적화이론 / 진화연산 / 물리정보신경망",
    careerHeading: "주요 경력",
    career: [
      "제주대학교 컴퓨터공학과 부교수 (2026.03 ~ 현재)",
      "동서대학교 소프트웨어학과 조교수, 부교수 (2019.10 ~ 2026.02)",
      "산업인공지능 표준화 포럼 운영위원 (2021.10 ~ 현재)",
      "한국지능시스템학회 총무이사 (2021.02 ~ 현재)",
      "한국컴퓨터정보학회 이사 (2020.03 ~ 현재)",
      "중앙대학교 박사후연구원 (2019.03 ~ 2019.09)",
    ],
    interestsHeading: "연구 관심 분야",
    pubsHeading: "주요 논문",
    projectsHeading: "참여 과제",
    patentsHeading: "특허",
    researchItems: [
      {
        title: "지능시스템 (Intelligent Systems)",
        description:
          "다중 에이전트 시스템, 지능형 제어, 뇌-컴퓨터 인터페이스(BCI) 등 지능시스템의 설계와 응용 연구",
      },
      {
        title: "인공생명 (Artificial Life)",
        description:
          "다중 에이전트 기반 인공생명 시스템의 창발적 행동, 자기 조직화, 적응 메커니즘을 컴퓨터 시뮬레이션으로 연구",
      },
      {
        title: "기계학습 (Machine Learning)",
        description:
          "딥러닝, 강화학습 등 기계학습 알고리즘 연구 및 실제 데이터 기반 문제 해결 적용",
      },
      {
        title: "최적화 이론 (Optimization Theory)",
        description:
          "진화연산, 메타휴리스틱, 물리정보신경망(PINN) 등 자연 기반 최적화 알고리즘 연구 및 응용",
      },
    ],
    patents: [
      { year: "20XX", title: "예시 특허 제목", number: "제 10-XXXXXXX호", status: "등록" },
      { year: "20XX", title: "예시 특허 제목 2", number: "제 10-XXXXXXX호", status: "출원" },
    ],
    patentRegistered: "등록",
  },
  en: {
    pageTitle: "Professor | SAL Lab",
    metaDescription: "Prof. Seungmin Park - SAL Laboratory",
    headerTitle: "Professor",
    breadcrumb: "SAL > Professor",
    photoAlt: "Prof. Seungmin Park",
    name: "Seungmin Park",
    rankBadge: "Associate Professor",
    titleLine: "Associate Professor · Ph.D.",
    affiliation: "Dept. of Computer Engineering, Jeju National University",
    bioHeading: "Biography",
    bioParagraphs: [
      "Prof. Seungmin Park researches Intelligent Systems, Artificial Life, Machine Learning, and Optimization Theory at the Department of Computer Engineering, Jeju National University. His specializations include evolutionary computation, physics-informed neural networks (PINN), and brain-computer interfaces (BCI).",
      "He leads the SAL (Soft Artificial Life) Laboratory, conducting various research projects with graduate and undergraduate researchers in artificial life simulation, intelligent systems, machine learning applications, and optimization.",
    ],
    educationHeading: "Education",
    education: [
      "Ph.D. in Control & Systems Engineering, Intelligent Systems — Chung-Ang University (Feb. 2019)",
      "B.S. in Electrical & Electronic Engineering — Chung-Ang University (Feb. 2010)",
    ],
    contactHeading: "Contact",
    emailLabel: "Email:",
    specLabel: "Specializations:",
    spec: "Intelligent Systems / Optimization Theory / Evolutionary Computation / PINN",
    careerHeading: "Career",
    career: [
      "Associate Professor, Dept. of Computer Engineering, Jeju National University (Mar. 2026 – Present)",
      "Assistant/Associate Professor, Dept. of Software, Dongseo University (Oct. 2019 – Feb. 2026)",
      "Executive Committee Member, Industrial AI Standardization Forum (Oct. 2021 – Present)",
      "General Affairs Director, Korean Institute of Intelligent Systems (Feb. 2021 – Present)",
      "Director, Korea Association of Computer Information (Mar. 2020 – Present)",
      "Postdoctoral Researcher, Chung-Ang University (Mar. 2019 – Sep. 2019)",
    ],
    interestsHeading: "Research Interests",
    pubsHeading: "Selected Publications",
    projectsHeading: "Research Projects",
    patentsHeading: "Patents",
    researchItems: [
      {
        title: "Intelligent Systems",
        description:
          "Research on the design and application of intelligent systems including multi-agent systems, intelligent control, and brain-computer interfaces (BCI)",
      },
      {
        title: "Artificial Life",
        description:
          "Studying emergent behavior, self-organization, and adaptation mechanisms in multi-agent-based artificial life systems through computer simulation",
      },
      {
        title: "Machine Learning",
        description:
          "Researching machine learning algorithms such as deep learning and reinforcement learning, and applying them to real-world data-driven problem solving",
      },
      {
        title: "Optimization Theory",
        description:
          "Researching nature-inspired optimization algorithms such as evolutionary computation, metaheuristics, and physics-informed neural networks (PINN)",
      },
    ],
    patents: [
      { year: "20XX", title: "Example Patent Title", number: "No. 10-XXXXXXX", status: "Registered" },
      { year: "20XX", title: "Example Patent Title 2", number: "No. 10-XXXXXXX", status: "Filed" },
    ],
    patentRegistered: "Registered",
  },
} as const;

const T = dict[lang];

// Show first 6 publications from publications.yaml (yaml order).
const publications = loadPublications()
  .slice(0, 6)
  .map((p) => ({
    type: p.type === "journal" ? "Journal" : "Conference",
    title: p.title,
    authors: p.authors.join(", "),
    venue: p.venue,
    year: p.year,
  }));

// Show one ongoing + one completed sample from projects.yaml.
const allProjects = loadProjects();
const projects = [
  ...allProjects.filter((p) => p.status === "ongoing").slice(0, 1),
  ...allProjects.filter((p) => p.status === "completed").slice(0, 1),
].map((p) => ({
  period: p.period,
  title: lang === "en" ? (p.titleEn || p.title) : p.title,
  funding: p.funding,
  description: p.description,
}));
---

<BaseLayout
  title={T.pageTitle}
  description={T.metaDescription}
  activeNav="Professor"
  lang={lang}
>
  <PageHeader title={T.headerTitle} breadcrumb={T.breadcrumb} />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <!-- Profile Section -->
    <section class="flex flex-col lg:flex-row gap-10 mb-[48px]">
      <!-- Left: Photo -->
      <div class="shrink-0">
        <img
          src="/images/professor/park-seungmin.jpg"
          alt={T.photoAlt}
          width="280"
          height="350"
          class="w-[280px] rounded-lg object-cover bg-secondary"
        />
      </div>

      <!-- Right: Info -->
      <div class="flex-1 min-w-0">
        <!-- Name & Badge -->
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[24px] font-bold text-foreground">{T.name}</h2>
          <span
            class="inline-flex items-center px-2 py-0.5 rounded-pill bg-secondary text-secondary-foreground text-sm font-medium"
          >
            {T.rankBadge}
          </span>
        </div>

        <!-- Title & Affiliation -->
        <p class="text-lg text-foreground font-medium mb-1">{T.titleLine}</p>
        <p class="text-base text-muted mb-6">{T.affiliation}</p>

        <!-- Bio -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.bioHeading}</h3>
          <div class="space-y-3 text-base text-muted leading-relaxed">
            {T.bioParagraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <!-- Education -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.educationHeading}</h3>
          <ul class="space-y-1.5 text-base text-muted">
            {T.education.map((line) => (
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Contact -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.contactHeading}</h3>
          <ul class="space-y-1.5 text-base text-muted">
            <li>
              <span class="text-foreground font-medium">{T.emailLabel}</span>{" "}
              <a
                href="mailto:spark@jejunu.ac.kr"
                class="hover:text-foreground transition-colors underline underline-offset-2"
              >
                spark@jejunu.ac.kr
              </a>
            </li>
            <li>
              <span class="text-foreground font-medium">{T.specLabel}</span> {T.spec}
            </li>
          </ul>
        </div>

        <!-- Career -->
        <div>
          <h3 class="text-lg font-semibold text-foreground mb-2">{T.careerHeading}</h3>
          <ul class="space-y-1.5 text-base text-muted">
            {T.career.map((line) => (
              <li class="flex items-start gap-2">
                <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Research Interests — Accordion -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.interestsHeading}</h2>
      <Accordion items={[...T.researchItems]} client:load />
    </section>

    <!-- Publications -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.pubsHeading}</h2>
      <div class="space-y-4">
        {publications.map((pub) => (
          <div class="border border-border rounded-lg p-5">
            <div class="flex items-start gap-3 mb-2">
              <span
                class={`inline-flex items-center shrink-0 px-2 py-0.5 rounded-pill text-xs font-medium ${
                  pub.type === "Journal"
                    ? "bg-secondary text-secondary-foreground"
                    : "bg-[#EFF6FF] text-[#1D4ED8]"
                }`}
              >
                {pub.type}
              </span>
              <h3 class="text-lg font-semibold text-foreground leading-snug">
                {pub.title}
              </h3>
            </div>
            <p class="text-base text-muted mt-1">{pub.authors}</p>
            <p class="text-sm text-muted-foreground">{pub.venue}, {pub.year}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Research Projects -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.projectsHeading}</h2>
      <div class="space-y-4">
        {projects.map((project) => (
          <div class="border border-border rounded-lg p-5">
            <div class="flex items-start gap-3 mb-2">
              <span class="inline-flex items-center shrink-0 px-2 py-0.5 rounded-pill bg-secondary text-secondary-foreground text-xs font-medium">
                {project.period}
              </span>
              <h3 class="text-lg font-semibold text-foreground leading-snug">
                {project.title}
              </h3>
            </div>
            <p class="text-base text-muted mb-1 mt-1">{project.funding}</p>
            <p class="text-sm text-muted-foreground">{project.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Patents -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">{T.patentsHeading}</h2>
      <div class="space-y-4">
        {T.patents.map((patent) => (
          <div class="border border-border rounded-lg p-5">
            <div class="flex items-start gap-3 mb-2">
              <span class={`inline-flex items-center shrink-0 px-2 py-0.5 rounded-pill text-xs font-medium ${
                patent.status === T.patentRegistered
                  ? "bg-[#D1FAE5] text-[#065F46]"
                  : "bg-[#FEF3C7] text-[#92400E]"
              }`}>
                {patent.status}
              </span>
              <h3 class="text-lg font-semibold text-foreground leading-snug">
                {patent.title}
              </h3>
            </div>
            <p class="text-sm text-muted-foreground">
              {patent.number} · {patent.year}
            </p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
