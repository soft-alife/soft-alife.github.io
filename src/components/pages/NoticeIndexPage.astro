---
/**
 * Notice list page (shared between /notice and /en/notice).
 *
 * The list itself (search + pagination) is rendered by NoticeList.tsx;
 * this page loads/sorts the collection and passes plain data down.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import NoticeList from "@/components/sections/NoticeList";
import { getCollection } from "astro:content";

interface Props {
  lang: "ko" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";

const dict = {
  ko: {
    pageTitle: "Notice — SAL Lab",
    metaDescription: "SAL 연구실 공지사항",
    headerTitle: "Notice",
    breadcrumb: "SAL > Notice",
    pinnedTitle: "고정 공지",
    pinnedTag: "[고정]",
    empty: "검색 결과가 없습니다.",
    searchPlaceholder: "검색",
  },
  en: {
    pageTitle: "Notice — SAL Lab",
    metaDescription: "SAL Laboratory Notices",
    headerTitle: "Notice",
    breadcrumb: "SAL > Notice",
    pinnedTitle: "Pinned",
    pinnedTag: "[Pinned]",
    empty: "No results found.",
    searchPlaceholder: "Search",
  },
} as const;

const T = dict[lang];

const allNotices = await getCollection("notices");

// Pinned first, then by date descending
const sorted = allNotices.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const formatDate = (date: Date) => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  const d = String(date.getDate()).padStart(2, "0");
  return `${y}.${m}.${d}`;
};

const notices = sorted.map((notice) => ({
  slug: notice.id.replace(/\.md$/, ""),
  title: notice.data.title,
  date: formatDate(notice.data.date),
  category: notice.data.category,
  pinned: notice.data.pinned,
}));
---

<BaseLayout
  title={T.pageTitle}
  description={T.metaDescription}
  activeNav="Notice"
  lang={lang}
>
  <PageHeader title={T.headerTitle} breadcrumb={T.breadcrumb} />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <NoticeList
      notices={notices}
      labels={{
        pinnedTitle: T.pinnedTitle,
        pinnedTag: T.pinnedTag,
        empty: T.empty,
        searchPlaceholder: T.searchPlaceholder,
      }}
      prefix={prefix}
      client:load
    />
  </div>
</BaseLayout>
