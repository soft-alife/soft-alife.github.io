---
/**
 * Home page (shared between / and /en/).
 *
 * Edit text via `dict` below. Layout/markup is identical for both languages.
 * URL prefixes for internal links are computed via `prefix()`.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeBanner from "@/components/sections/HomeBanner";
import { getCollection } from "astro:content";
import { loadMembers, loadSite, t } from "@/lib/content";

interface Props {
  lang: "ko" | "en";
}

const { lang } = Astro.props;
const prefix = lang === "en" ? "/en" : "";

const dict = {
  ko: {
    pageTitle: "SAL Lab — Soft Artificial Life Laboratory",
    metaDescription:
      "제주대학교 컴퓨터공학과 SAL(Soft Artificial Life) 연구실 공식 웹사이트",
    heroEyebrow: "Jeju National University · Dept. of Computer Engineering",
    heroBodyLine1: "지능시스템, 인공생명, 기계학습, 최적화 이론을 연구하는",
    heroBodyLine2: "제주대학교 SAL 연구실입니다.",
    newsHeading: "News",
    notice: "Notice",
    researchAreasHeading: "Research Areas",
    membersHeading: "Members",
    allLink: "All →",
    profLabel: "부교수 · 컴퓨터공학과",
    profProfile: "프로필 보기",
    profEmail: "이메일",
    profAlt: "박승민 교수",
    profName: "박승민",
    emptyNews: "등록된 소식이 없습니다.",
    emptyNotices: "등록된 공지가 없습니다.",
    researchAreas: [
      {
        num: "01",
        title: "지능시스템",
        description:
          "다중 에이전트 시스템, 지능형 제어, 뇌-컴퓨터 인터페이스 등 지능시스템의 설계와 응용을 연구합니다.",
      },
      {
        num: "02",
        title: "인공생명",
        description:
          "다중 에이전트 기반 인공생명 시스템의 창발적 행동을 연구하고, 생명 현상의 본질적 특성을 컴퓨터 시뮬레이션으로 재현합니다.",
      },
      {
        num: "03",
        title: "기계학습",
        description:
          "딥러닝, 강화학습 등 기계학습 알고리즘을 연구하고, 실제 데이터 기반의 문제 해결에 적용합니다.",
      },
      {
        num: "04",
        title: "최적화 이론",
        description:
          "진화연산, 메타휴리스틱 등 자연에서 영감을 받은 최적화 알고리즘을 연구하고 실제 문제에 적용합니다.",
      },
    ],
  },
  en: {
    pageTitle: "SAL Lab — Soft Artificial Life Laboratory",
    metaDescription:
      "Official website of SAL (Soft Artificial Life) Laboratory, Dept. of Computer Engineering, Jeju National University",
    heroEyebrow: "Jeju National University · Dept. of Computer Engineering",
    heroBodyLine1: "Researching Intelligent Systems, Artificial Life,",
    heroBodyLine2: "Machine Learning, and Optimization Theory.",
    newsHeading: "News",
    notice: "Notice",
    researchAreasHeading: "Research Areas",
    membersHeading: "Members",
    allLink: "All →",
    profLabel: "Associate Professor · Computer Engineering",
    profProfile: "Profile",
    profEmail: "Email",
    profAlt: "Prof. Seungmin Park",
    profName: "Seungmin Park",
    emptyNews: "No news yet.",
    emptyNotices: "No notices registered.",
    researchAreas: [
      {
        num: "01",
        title: "Intelligent Systems",
        description:
          "Research on the design and application of intelligent systems including multi-agent systems, intelligent control, and brain-computer interfaces.",
      },
      {
        num: "02",
        title: "Artificial Life",
        description:
          "Studying emergent behavior in multi-agent-based artificial life systems and reproducing essential characteristics of life through computer simulation.",
      },
      {
        num: "03",
        title: "Machine Learning",
        description:
          "Researching machine learning algorithms such as deep learning and reinforcement learning, and applying them to real-world data-driven problem solving.",
      },
      {
        num: "04",
        title: "Optimization Theory",
        description:
          "Researching nature-inspired optimization algorithms such as evolutionary computation and metaheuristics, and applying them to real-world problems.",
      },
    ],
  },
} as const;

const T = dict[lang];
const site = loadSite();

// 홈 배너 캐러셀 슬라이드 (언어별 문자열로 변환해서 전달)
const bannerSlides = site.banners
  .filter((b) => b.enabled)
  .map((b) => ({
    label: t(b.label, lang),
    title: t(b.title, lang),
    body: t(b.body, lang),
    button: t(b.button, lang),
    link: t(b.link, lang),
  }));

// Fetch content collections
const newsItems = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((e) => ({
    title: e.data.title,
    date: e.data.date,
    source: e.data.source,
    href: e.data.link || `${prefix}/news/${e.id.replace(/\.md$/, "")}`,
    external: e.data.link !== "",
  }));

const notices = (await getCollection("notices"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const members = loadMembers().filter((m) => !m.graduated).slice(0, 4);
const memberDisplayName = (m: typeof members[number]) =>
  lang === "en" ? (m.nameEn || m.name) : m.name;

function formatDate(date: Date): string {
  return date.toISOString().split("T")[0];
}
---

<BaseLayout
  title={T.pageTitle}
  description={T.metaDescription}
  activeNav="Home"
  lang={lang}
>
  <!-- Hero Section -->
  <section>
    <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-10 md:py-[72px] flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <!-- Left -->
      <div class="flex flex-col">
        <p class="text-[12px] md:text-[14px] text-muted tracking-wide mb-2">
          {T.heroEyebrow}
        </p>
        <h1
          class="text-[28px] md:text-[42px] font-bold text-foreground leading-tight whitespace-pre-line"
        >
          Soft Artificial Life<br />Laboratory
        </h1>
        <div class="w-[40px] h-[1px] bg-border mt-4 mb-4 md:mt-5 md:mb-5"></div>
        <p class="text-base md:text-lg text-muted leading-relaxed max-w-[480px]">
          {T.heroBodyLine1}
          <br class="hidden md:block" />
          {T.heroBodyLine2}
        </p>
      </div>
      <!-- Right: SAL Logo -->
      <div class="flex-shrink-0 hidden md:block md:ml-12">
        <img
          src="/images/logos/sal-logo.png"
          alt="SAL Laboratory Logo"
          width="160"
          height="160"
          class="w-[160px] h-[160px] object-contain"
        />
      </div>
    </div>
  </section>

  <!-- Banner Carousel (회색 배경, 10초마다 자동 전환) -->
  {bannerSlides.length > 0 && <HomeBanner slides={bannerSlides} client:load />}

  <!-- Content Grid -->
  <section>
    <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-section flex flex-col lg:flex-row gap-6">
      <!-- Left: News -->
      <div class="flex-1 min-w-0 flex flex-col">
        <div class="border border-border rounded-lg bg-card flex flex-col flex-1">
          <div
            class="flex items-center justify-between px-6 py-4 border-b border-border"
          >
            <h2 class="text-lg font-semibold text-foreground">
              {T.newsHeading}
            </h2>
            <a
              href={`${prefix}/news`}
              class="text-base text-muted hover:text-foreground transition-colors"
            >
              {T.allLink}
            </a>
          </div>
          <div class="divide-y divide-border flex-1">
            {newsItems.length > 0 ? (
              newsItems.map((item) => (
                <a
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener noreferrer" : undefined}
                  class="flex items-start gap-4 px-6 py-4 hover:bg-secondary/50 transition-colors overflow-hidden"
                >
                  <span class="text-sm text-muted-foreground whitespace-nowrap mt-0.5">
                    {formatDate(item.date)}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class="text-md font-medium text-foreground truncate">
                      {item.title}
                    </p>
                    {item.source && (
                      <p class="text-base text-muted mt-0.5">{item.source}</p>
                    )}
                  </div>
                </a>
              ))
            ) : (
              <div class="px-6 py-8 text-center text-base text-muted">
                {T.emptyNews}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="w-full lg:w-[428px] flex-shrink-0 flex flex-col gap-6">
        <!-- Professor Mini Card -->
        <div class="border border-border rounded-lg bg-card p-5">
          <div class="flex items-center gap-4">
            <img
              src="/images/professor/park-seungmin.jpg"
              alt={T.profAlt}
              width="64"
              height="64"
              class="w-16 h-16 rounded-full object-cover bg-secondary"
            />
            <div>
              <p class="text-lg font-semibold text-foreground">{T.profName}</p>
              <p class="text-base text-muted">{T.profLabel}</p>
            </div>
          </div>
          <div class="flex items-center gap-3 mt-4">
            <a
              href={`${prefix}/professor`}
              class="text-base text-muted hover:text-foreground transition-colors underline underline-offset-2"
            >
              {T.profProfile}
            </a>
            <span class="text-border">|</span>
            <a
              href="mailto:spark@jejunu.ac.kr"
              class="text-base text-muted hover:text-foreground transition-colors underline underline-offset-2"
            >
              {T.profEmail}
            </a>
          </div>
        </div>

        <!-- Notice Card -->
        <div class="border border-border rounded-lg bg-card flex-1">
          <div
            class="flex items-center justify-between px-6 py-4 border-b border-border"
          >
            <h2 class="text-lg font-semibold text-foreground">{T.notice}</h2>
            <a
              href={`${prefix}/notice`}
              class="text-base text-muted hover:text-foreground transition-colors"
            >
              {T.allLink}
            </a>
          </div>
          <div class="divide-y divide-border">
            {notices.length > 0 ? (
              notices.map((notice) => (
                <a
                  href={`${prefix}/notice/${notice.id.replace(/\.md$/, "")}`}
                  class="flex items-start gap-4 px-6 py-4 hover:bg-secondary/50 transition-colors overflow-hidden"
                >
                  <span class="text-sm text-muted-foreground whitespace-nowrap mt-0.5">
                    {formatDate(notice.data.date)}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class="text-md font-medium text-foreground truncate">
                      {notice.data.title}
                    </p>
                  </div>
                  <span class="flex-shrink-0 inline-flex items-center px-2 py-0.5 bg-secondary text-secondary-foreground text-xs rounded-pill">
                    {notice.data.category}
                  </span>
                </a>
              ))
            ) : (
              <div class="px-6 py-8 text-center text-base text-muted">
                {T.emptyNotices}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Areas -->
  <section>
    <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] pb-section">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-3xl font-bold text-foreground">{T.researchAreasHeading}</h2>
        <a
          href={`${prefix}/about`}
          class="text-base text-muted hover:text-foreground transition-colors"
        >
          {T.allLink}
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {T.researchAreas.map((area) => (
          <div class="border border-border rounded-lg p-5">
            <span class="text-lg text-muted-foreground font-medium">{area.num}</span>
            <h3 class="text-lg font-semibold text-foreground mt-2">{area.title}</h3>
            <p class="text-base text-muted mt-2 leading-relaxed">{area.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Members Preview -->
  <section>
    <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] pb-section">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-3xl font-bold text-foreground">{T.membersHeading}</h2>
        <a
          href={`${prefix}/members`}
          class="text-base text-muted hover:text-foreground transition-colors"
        >
          {T.allLink}
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {members.map((member) => (
          <div class="border border-border rounded-lg p-5 flex flex-col items-center text-center">
            <img
              src={member.photo}
              alt={memberDisplayName(member)}
              width="72"
              height="72"
              class="w-[72px] h-[72px] rounded-full object-cover bg-secondary"
            />
            <p class="text-md font-semibold text-foreground mt-3">
              {memberDisplayName(member)}
            </p>
            <p class="text-base text-muted mt-0.5">{member.role}</p>
            <div class="flex flex-wrap justify-center gap-1.5 mt-2">
              {member.research.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 bg-secondary text-secondary-foreground text-xs rounded-pill">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex items-center gap-2 mt-3">
              {member.email && (
                <a
                  href={`mailto:${member.email}`}
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  title="Email"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                </a>
              )}
              {member.github && (
                <a
                  href={member.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground hover:text-foreground transition-colors"
                  title="GitHub"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                    <path d="M9 18c-4.51 2-5-2-7-2" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
