---
interface Props {
  title: string;
  breadcrumb?: string;
}

const { title, breadcrumb } = Astro.props;
---

<div class="bg-[#FAFAFA] border-b border-border px-6 lg:px-[60px] pt-7 pb-5">
  <div class="max-w-[1200px] mx-auto">
    {breadcrumb && (
      <p class="text-[15px] font-semibold text-muted-foreground mb-2">{breadcrumb}</p>
    )}
    <h1 class="text-[38px] font-extrabold text-foreground">{title}</h1>
  </div>
</div>
