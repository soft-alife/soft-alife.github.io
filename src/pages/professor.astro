---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import Accordion from "@/components/ui/Accordion.tsx";

const researchItems = [
  {
    title: "지능시스템 (Intelligent Systems)",
    description:
      "다중 에이전트 시스템, 지능형 제어, 뇌-컴퓨터 인터페이스(BCI) 등 지능시스템의 설계와 응용 연구",
  },
  {
    title: "인공생명 (Artificial Life)",
    description:
      "다중 에이전트 기반 인공생명 시스템의 창발적 행동, 자기 조직화, 적응 메커니즘을 컴퓨터 시뮬레이션으로 연구",
  },
  {
    title: "기계학습 (Machine Learning)",
    description:
      "딥러닝, 강화학습 등 기계학습 알고리즘 연구 및 실제 데이터 기반 문제 해결 적용",
  },
  {
    title: "최적화 이론 (Optimization Theory)",
    description:
      "진화연산, 메타휴리스틱, 물리정보신경망(PINN) 등 자연 기반 최적화 알고리즘 연구 및 응용",
  },
];

const publications = [
  {
    type: "Journal",
    title: "Schizophrenia Detection and Classification: A Systematic Review of the Last Decade",
    authors: "S. Park et al.",
    venue: "Diagnostics (MDPI)",
    year: 2024,
  },
  {
    type: "Journal",
    title: "Enhancing Control Systems through Type-3 Fuzzy Logic Optimization",
    authors: "P. Ochoa, C. Peraza, P. Melin, O. Castillo, S. Park, Z. W. Geem",
    venue: "Mathematics (MDPI)",
    year: 2024,
  },
  {
    type: "Conference",
    title: "KoGPT-2 Integrated SSVEP-Based BCI for Efficient Language Processing",
    authors: "S. Oh, D. Cho, S. Park, M. Moon",
    venue: "ResearchGate",
    year: 2025,
  },
  {
    type: "Journal",
    title: "EEG Electrode Selection Method based on BPSO with Channel Impact Factor for Acquisition of Significant Brain Signal",
    authors: "S. Park, J. Kim, K. Sim",
    venue: "Optik (Elsevier)",
    year: 2018,
  },
  {
    type: "Journal",
    title: "Harmony Search-based Hidden Markov Model Optimization for Online Classification of Single Trial EEGs",
    authors: "S. Park, K. Ko, K. Sim",
    venue: "International Journal of Control, Automation and Systems (Springer)",
    year: 2013,
  },
  {
    type: "Journal",
    title: "Trial Pruning based on Genetic Algorithm for Single-Trial EEG Classification",
    authors: "S. Park et al.",
    venue: "Computers & Electrical Engineering (Elsevier)",
    year: 2012,
  },
];

const projects = [
  {
    period: "20XX–20XX",
    title: "예시 진행 과제 제목",
    funding: "예시 지원 기관",
    description: "예시 과제 설명이 들어갑니다. 실제 과제 정보로 교체해 주세요.",
  },
  {
    period: "20XX–20XX",
    title: "예시 완료 과제 제목",
    funding: "예시 지원 기관",
    description: "예시 과제 설명이 들어갑니다. 실제 과제 정보로 교체해 주세요.",
  },
];
---

<BaseLayout
  title="지도교수 | SAL Lab"
  description="SAL 연구실 지도교수 박승민 교수 소개"
  activeNav="Professor"
>
  <PageHeader title="Professor" breadcrumb="SAL > 지도교수" />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <!-- Profile Section -->
    <section class="flex flex-col lg:flex-row gap-10 mb-[48px]">
      <!-- Left: Photo -->
      <div class="shrink-0">
        <img
          src="/images/professor/park-seungmin.jpg"
          alt="박승민 교수 프로필 사진"
          width="280"
          height="350"
          class="w-[280px] rounded-lg object-cover bg-secondary"
        />
      </div>

      <!-- Right: Info -->
      <div class="flex-1 min-w-0">
        <!-- Name & Badge -->
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[24px] font-bold text-foreground">박승민</h2>
          <span
            class="inline-flex items-center px-2 py-0.5 rounded-pill bg-secondary text-secondary-foreground text-sm font-medium"
          >
            부교수
          </span>
        </div>

        <!-- Title & Affiliation -->
        <p class="text-lg text-foreground font-medium mb-1">
          박승민 부교수 · Ph.D.
        </p>
        <p class="text-base text-muted mb-6">
          제주대학교 공과대학 컴퓨터공학과
        </p>

        <!-- Bio -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">소개</h3>
          <div class="space-y-3 text-base text-muted leading-relaxed">
            <p>
              박승민 교수는 제주대학교 컴퓨터공학과에서 지능시스템, 인공생명, 기계학습,
              최적화 이론 분야를 연구하고 있습니다.
              진화연산, 물리정보신경망(PINN), 뇌-컴퓨터 인터페이스(BCI) 등을 세부 전공으로 하고 있습니다.
            </p>
            <p>
              SAL(Soft A-Life) 연구실을 이끌며, 대학원생 및 학부 연구생들과 함께
              인공생명 시뮬레이션, 지능시스템, 기계학습 응용, 최적화 등
              다양한 연구 프로젝트를 수행하고 있습니다.
            </p>
          </div>
        </div>

        <!-- Education -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-foreground mb-2">학력</h3>
          <ul class="space-y-1.5 text-base text-muted">
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>공학박사 — 중앙대학교 제어및시스템공학, 지능시스템 (2019.02)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>공학사 — 중앙대학교 전자전기공학부 (2010.02)</span>
            </li>
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h3 class="text-lg font-semibold text-foreground mb-2">연락처</h3>
          <ul class="space-y-1.5 text-base text-muted">
            <li>
              <span class="text-foreground font-medium">이메일:</span>{" "}
              <a
                href="mailto:spark@jejunu.ac.kr"
                class="hover:text-foreground transition-colors underline underline-offset-2"
              >
                spark@jejunu.ac.kr
              </a>
            </li>
            <li>
              <span class="text-foreground font-medium">세부전공:</span>{" "}
              지능시스템 / 최적화이론 / 진화연산 / 물리정보신경망
            </li>
          </ul>
        </div>

        <!-- Career -->
        <div>
          <h3 class="text-lg font-semibold text-foreground mb-2">주요 경력</h3>
          <ul class="space-y-1.5 text-base text-muted">
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>제주대학교 컴퓨터공학과 부교수 (2026.03 ~ 현재)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>동서대학교 소프트웨어학과 조교수, 부교수 (2019.10 ~ 2026.02)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>산업인공지능 표준화 포럼 운영위원 (2021.10 ~ 현재)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>한국지능시스템학회 총무이사 (2021.02 ~ 현재)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>한국컴퓨터정보학회 이사 (2020.03 ~ 현재)</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-muted-foreground mt-1.5 shrink-0">•</span>
              <span>중앙대학교 박사후연구원 (2019.03 ~ 2019.09)</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Research Interests — Accordion -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">연구 관심 분야</h2>
      <Accordion items={researchItems} client:load />
    </section>

    <!-- Publications -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">주요 논문</h2>
      <div class="space-y-4">
        {
          publications.map((pub) => (
            <div class="border border-border rounded-lg p-5">
              <div class="flex items-start gap-3 mb-2">
                <span
                  class={`inline-flex items-center shrink-0 px-2 py-0.5 rounded-pill text-xs font-medium ${
                    pub.type === "Journal"
                      ? "bg-secondary text-secondary-foreground"
                      : "bg-[#EFF6FF] text-[#1D4ED8]"
                  }`}
                >
                  {pub.type}
                </span>
                <h3 class="text-lg font-semibold text-foreground leading-snug">
                  {pub.title}
                </h3>
              </div>
              <p class="text-base text-muted mt-1">
                {pub.authors}
              </p>
              <p class="text-sm text-muted-foreground">
                {pub.venue}, {pub.year}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Research Projects -->
    <section class="mb-[48px]">
      <h2 class="text-[20px] font-bold text-foreground mb-4">참여 과제</h2>
      <div class="space-y-4">
        {
          projects.map((project) => (
            <div class="border border-border rounded-lg p-5">
              <div class="flex items-start gap-3 mb-2">
                <span class="inline-flex items-center shrink-0 px-2 py-0.5 rounded-pill bg-secondary text-secondary-foreground text-xs font-medium">
                  {project.period}
                </span>
                <h3 class="text-lg font-semibold text-foreground leading-snug">
                  {project.title}
                </h3>
              </div>
              <p class="text-base text-muted mb-1 mt-1">
                {project.funding}
              </p>
              <p class="text-sm text-muted-foreground">
                {project.description}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
