---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import MemberCard from "@/components/sections/MemberCard.astro";
import { loadMembers, partitionMembers } from "@/lib/content";

const { graduates, undergrads, alumni } = partitionMembers(loadMembers());
---

<BaseLayout
  title="Member - SAL Laboratory"
  description="SAL 연구실 구성원 소개"
  activeNav="Members"
>
  <PageHeader title="Member" breadcrumb="SAL > 연구실 소개 > 멤버" />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    <!-- Graduate Students -->
    {graduates.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-foreground mb-4">대학원생</h2>
        <div class="border-t border-border mb-6"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {graduates.map((member: any) => (
            <MemberCard
              name={member.name}
              role={member.role}
              photo={member.photo}
              research={member.research}
              email={member.email}
              github={member.github}
              scholar={member.scholar}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Undergraduate Researchers -->
    {undergrads.length > 0 && (
      <section class="mt-[48px]">
        <h2 class="text-2xl font-bold text-foreground mb-4">학부 연구생</h2>
        <div class="border-t border-border mb-6"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {undergrads.map((member: any) => (
            <MemberCard
              name={member.name}
              role={member.role}
              photo={member.photo}
              research={member.research}
              email={member.email}
              github={member.github}
              scholar={member.scholar}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Alumni -->
    {alumni.length > 0 && (
      <section class="mt-[48px]">
        <h2 class="text-2xl font-bold text-foreground mb-4">졸업생</h2>
        <div class="border-t border-border mb-6"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {alumni.map((member: any) => (
            <MemberCard
              name={member.name}
              role={member.role}
              photo={member.photo}
              research={member.research}
              email={member.email}
              github={member.github}
              scholar={member.scholar}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
