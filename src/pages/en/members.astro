---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import MemberCard from "@/components/sections/MemberCard.astro";
import { loadMembers, partitionMembers } from "@/lib/content";

const { graduates, undergrads, alumni } = partitionMembers(loadMembers());
---

<BaseLayout
  title="Members - SAL Laboratory"
  description="SAL Laboratory Members"
  activeNav="Members"
  lang="en"
>
  <PageHeader title="Members" breadcrumb="SAL > Members" />

  <div class="max-w-[1200px] mx-auto px-6 lg:px-[60px] py-[40px]">
    {graduates.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-foreground mb-4">Graduate Students</h2>
        <div class="border-t border-border mb-6"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {graduates.map((member: any) => (
            <MemberCard
              name={member.nameEn || member.name}
              role={member.role}
              photo={member.photo}
              research={member.research}
              email={member.email}
              github={member.github}
              scholar={member.scholar}
            />
          ))}
        </div>
      </section>
    )}

    {undergrads.length > 0 && (
      <section class="mt-[48px]">
        <h2 class="text-2xl font-bold text-foreground mb-4">Undergraduate Researchers</h2>
        <div class="border-t border-border mb-6"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {undergrads.map((member: any) => (
            <MemberCard
              name={member.nameEn || member.name}
              role={member.role}
              photo={member.photo}
              research={member.research}
              email={member.email}
              github={member.github}
              scholar={member.scholar}
            />
          ))}
        </div>
      </section>
    )}

    {alumni.length > 0 && (
      <section class="mt-[48px]">
        <h2 class="text-2xl font-bold text-foreground mb-4">Alumni</h2>
        <div class="border-t border-border mb-6"></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {alumni.map((member: any) => (
            <MemberCard
              name={member.nameEn || member.name}
              role={member.role}
              photo={member.photo}
              research={member.research}
              email={member.email}
              github={member.github}
              scholar={member.scholar}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
